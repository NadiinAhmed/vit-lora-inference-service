# Copy to .env and adjust. Every value has a sensible default in src/config.py.
APP_BASE_MODEL_NAME=google/vit-base-patch16-224-in21k
APP_MODEL_DIR=models
APP_MODEL_VERSION=model-v1.0.0
APP_TOP_K=3
APP_MAX_IMAGE_BYTES=5242880
APP_LOG_LEVEL=INFO
# weight_only (portable) | dynamic (fast only on CPUs with fast INT8 matmul)
APP_QUANTIZATION_MODE=weight_only
# Where prediction and feedback logs are written (JSON Lines)
APP_LOG_DIR=logs
# APP_DATA_DIR=data
# APP_REPORTS_DIR=reports
